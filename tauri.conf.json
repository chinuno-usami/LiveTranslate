{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "ASR Translate",
    "version": "0.1.0"
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "tauri-ui",
    "distDir": "tauri-ui"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": false,
      "identifier": "com.chinuno.asrtranslate",
      "targets": "all"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "ASR Translate Overlay",
        "width": 1200,
        "height": 220,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "focus": true
      }
    ]
  }
}
