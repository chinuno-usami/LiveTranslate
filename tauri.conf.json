{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "LiveTranslate",
    "version": "0.1.0"
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "tauri-ui",
    "distDir": "tauri-ui"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "title": "LiveTranslate"
    },
    "bundle": {
      "active": false,
      "identifier": "com.chinuno.livetranslate",
      "targets": "all"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "LiveTranslate Overlay",
        "width": 1200,
        "height": 220,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "focus": true
      }
    ]
  }
}
